    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').item.json;\nconst chatId = String(trigger.chat_id);\nconst rows = $input.all().map(i => i.json);\nconst mine = rows.filter(r => String(r['Telegram Chat ID']) === chatId);\nconst active = mine.filter(r => (r['Status'] || 'Confirmed') !== 'Cancelled' && r['Calendar Event ID']);\nconst booking = active.length ? active[active.length - 1] : null;\nreturn [{\n  json: {\n    chat_id: chatId,\n    hasBooking: !!booking,\n    booking: booking || {}\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        576
