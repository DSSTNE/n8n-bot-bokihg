    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst tomorrow = DateTime.now().setZone('Europe/Stockholm').plus({ days: 1 });\n\nfunction parseDate(str) {\n  const parts = String(str || '').trim().split('.');\n  if (parts.length !== 3) return null;\n  const [d, m, y] = parts.map(p => parseInt(p, 10));\n  if (!d || !m || !y) return null;\n  return { d, m, y };\n}\n\nconst toRemind = rows.filter(r => {\n  const parsed = parseDate(r['Date']);\n  if (!parsed) return false;\n  const dateMatches = parsed.d === tomorrow.day && parsed.m === tomorrow.month && parsed.y === tomorrow.year;\n  const notCancelled = (r['Status'] || 'Confirmed') !== 'Cancelled';\n  const notReminded = String(r['Reminder Sent'] || '').toUpperCase() !== 'TRUE';\n  return dateMatches && notCancelled && notReminded;\n});\n\nreturn toRemind.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
