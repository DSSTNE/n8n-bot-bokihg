      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const triggerData = $('When Executed by Another Workflow').item.json;\nconst dateStr = triggerData.temp_date || '';\nconst timeStr = triggerData.text || '';\n\nconst dateParts = dateStr.split('.');\nconst timeParts = timeStr.split(':');\n\nlet isValidDate = dateParts.length === 3 && timeParts.length === 2;\nlet startDateTime = '';\nlet endDateTime = '';\n\nif (isValidDate) {\n  const [day, month, year] = dateParts;\n  const [hour, minute] = timeParts;\n  const startDate = DateTime.fromObject(\n    { year: Number(year), month: Number(month), day: Number(day), hour: Number(hour), minute: Number(minute) },\n    { zone: 'Europe/Stockholm' }\n  );\n\n  if (!startDate.isValid) {\n    isValidDate = false;\n  } else {\n    const endDate = startDate.plus({ minutes: 60 });\n    startDateTime = startDate.toUTC().toISO();\n    endDateTime = endDate.toUTC().toISO();\n  }\n}\n\nreturn {\n  ...triggerData,\n  startDateTime,\n  endDateTime,\n  isValidDate\n};"
      },
