      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const triggerData = $('When Executed by Another Workflow').item.json;\nconst dateStr = triggerData.temp_date || '';\nconst timeStr = triggerData.temp_time || '';\n\nconst dateParts = dateStr.split('.');\nconst timeParts = timeStr.split(':');\n\nconst startDate = DateTime.fromObject(\n  { year: Number(dateParts[2]), month: Number(dateParts[1]), day: Number(dateParts[0]), hour: Number(timeParts[0]), minute: Number(timeParts[1]) },\n  { zone: 'Europe/Stockholm' }\n);\n\nconst endDate = startDate.plus({ minutes: 60 });\n\nreturn {\n  ...triggerData,\n  startDateTime: startDate.toUTC().toISO(),\n  endDateTime: endDate.toUTC().toISO(),\n  phone_to_save: triggerData.text\n};"
      },
